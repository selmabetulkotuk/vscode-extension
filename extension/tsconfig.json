{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node", "mocha"],
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "out",
        "incremental": true,
        "tsBuildInfoFile": "./out/.tsbuildinfo",
        "skipLibCheck": true,
        "strict": true
    }
}